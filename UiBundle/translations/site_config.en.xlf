            <trans-unit id="f2Stp0E">
                <source>description.ai_assistant_dashboard_endpoint</source>
                <target>URL of the AI backend receiving dashboard questions. Empty = disabled (no default backend shipped).</target>
            </trans-unit>
            <trans-unit id="h8OG.GR">
                <source>description.ai_assistant_dashboard_not_enabled</source>
                <target>Enable it and set an endpoint and token to activate it</target>
            </trans-unit>
            <trans-unit id="JK32Qas">
                <source>description.ai_assistant_dashboard_token</source>
                <target>Bearer token sent to the dashboard AI assistant endpoint</target>
            </trans-unit>
            <trans-unit id="ChJQa4L">
                <source>description.ai_assistant_site_api_key</source>
                <target>LLM API key of the assistant answering about this site's own content, billed to its owner</target>
            </trans-unit>
            <trans-unit id="TuRhv3A">
                <source>description.ai_assistant_site_base_uri</source>
                <target>API base URL, required: the full messages endpoint for Anthropic, the product base for an OpenAI-compatible API (OpenAI, Euria)</target>
            </trans-unit>
            <trans-unit id="JvRH__R">
                <source>description.ai_assistant_site_label</source>
                <target>Name shown on the search badge, followed by the (AI) mention; empty, the assistant is called Donovan</target>
            </trans-unit>
            <trans-unit id="q_9MEfn">
                <source>description.ai_assistant_site_model</source>
                <target>Model of the site search, required: an empty entry keeps the feature off</target>
            </trans-unit>
            <trans-unit id="vzE2YaC">
                <source>description.ai_assistant_site_provider</source>
                <target>AI provider of the site search: anthropic, openai or euria</target>
            </trans-unit>
            <trans-unit id="7rGj8pw">
                <source>description.ai_assistant_site_retention_days</source>
                <target>Days after which a question nobody asked again is deleted (90 by default): a visitor may have typed personal data into it</target>
            </trans-unit>
            <trans-unit id="Qu54Zbe">
                <source>description.ai_assistant_writer_api_key</source>
                <target>API key for the chosen provider, billed to its owner</target>
            </trans-unit>
