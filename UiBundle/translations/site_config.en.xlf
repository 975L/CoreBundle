            <trans-unit id="bQILUAx">
                <source>description.ai_site_search_failure_alert</source>
                <target>The last call to the provider failed (revoked key, credit exhausted, outage): visitors see "search unavailable"</target>
            </trans-unit>
            <trans-unit id="o3sVBy1">
                <source>description.email_debug</source>
                <target>When enabled, a ROLE_SUPER_ADMIN sees a preview instead of a real send</target>
            </trans-unit>
            <trans-unit id="re7MGHJ">
                <source>description.recaptcha3_score_threshold</source>
                <target>Score threshold (between 0 and 1) below which ReCaptcha v3 considers the submission suspicious</target>
            </trans-unit>
            <trans-unit id="n0vSdf_">
                <source>description.recaptcha3_secret_key</source>
