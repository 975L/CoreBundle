            </trans-unit>
            <trans-unit id="716BbUn">
                <source>description.ai_assistant_writer_model</source>
                <target>Donovan (Writer) model id, required whatever the provider: no model is hardcoded as a fallback, an empty entry leaves the feature off</target>
            </trans-unit>
            <trans-unit id="Z8vTAHB">
                <source>description.ai_assistant_writer_provider</source>
                <target>AI provider of Donovan (Writer): anthropic, openai or euria</target>
