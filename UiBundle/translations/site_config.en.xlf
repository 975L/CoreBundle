                <source>description.site_matomo_id</source>
                <target>Matomo site ID (integer)</target>
            </trans-unit>
            <trans-unit id="X8T2_9z">
                <source>description.site_matomo_url</source>
                <target>URL of the Matomo instance i.e. https://matomo.example.com. Filled along with the ID, it enables Matomo, deliberately outside the cookie banner - only for a CNIL-exempt setup (anonymized IP, no cross-site tracking, cookie ≤13 months, DNT respected)</target>
            </trans-unit>
