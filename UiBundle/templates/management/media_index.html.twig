{% extends '@EasyAdmin/crud/index.html.twig' %}

{# Flex gallery instead of the default table: a media library reads better as thumbnails than as rows #}
{% block main %}
    <p>{{ ('label.info_media'|trans({}, 'ui')) }}</p>

    <div class="management-media-grid">
        {% for entity in entities %}
            {% if entity.isAccessible %}
                {% set media = entity.instance %}
                {% set thumbnailPath = media.filename ? document_thumbnail_path(media) : null %}

                {# Site-wide graphics are read-only here (see MediaCrudController), so their thumbnail opens the screen that does edit them instead of EasyAdmin's default row action - which, Edit being hidden for them, fell back to a detail page showing neither the image nor a single action. No url at all for an admin who may not edit them: the thumbnail then renders as plain content rather than as a link landing on a 403 #}
                {% set siteGraphicUrl = site_graphic_urls[media.id] ?? null %}
                {% set itemUrl = siteGraphicUrl ?? entity.defaultActionUrl %}

                {# The modifier says which form the thumbnail opens, the two being told apart nowhere else in the markup - the guided project walking the media library excludes it, its next steps pointing at fields only the Media form holds (see UiGuidedProjectProvider) #}
                <a{% if itemUrl %} href="{{ itemUrl }}"{% endif %} class="management-media-grid__item{% if siteGraphicUrl %} management-media-grid__item--site-graphic{% endif %}">
                    {% if media.filename and media.mimeType starts with 'image/' %}
                        <img src="{{ vich_uploader_asset(media) }}" alt="{{ media.alt }}" width="150" height="150" class="management-media-grid__thumb">
                    {% elseif thumbnailPath %}
                        <img src="{{ asset(thumbnailPath) }}" alt="{{ media.alt }}" width="150" height="150" class="management-media-grid__thumb">
                    {% else %}
                        <div class="management-media-grid__placeholder">
                            {{ media.filename }}
                        </div>
                    {% endif %}
                </a>
            {% endif %}
        {% endfor %}
    </div>

    {% if entities|length > 0 %}
        <div class="content-panel-footer without-padding without-border">
            {{ include(ea.templatePath('crud/paginator'), {render_detailed_pagination: true}) }}
        </div>
    {% endif %}

    {{ include('@EasyAdmin/crud/includes/_action_confirmation_modal.html.twig', with_context: false) }}
{% endblock main %}
