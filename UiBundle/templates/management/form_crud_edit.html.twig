{% extends '@EasyAdmin/crud/edit.html.twig' %}

{% block main %}
    {# The language the form is being written in, drawn by the partial ConfigBundle ships for every c975L edit screen. The defaults stand for the screen that declares none of it, an include under strict_variables raising rather than drawing nothing #}
    {{ include('@c975LConfig/management/_content_locale_tabs.html.twig', {
        content_locales: form_content_locales|default([]),
        content_locale: form_content_locale|default(null),
        content_default_locale: form_default_locale|default(null),
        content_urls: form_content_urls|default({}),
    }) }}

    {% if form_content_locale is defined and form_content_locale is not null %}
        <p class="text-muted">{{ 'label.form_translation_help'|trans({}, 'ui') }}</p>
    {% else %}
        <p>{{ ('label.info_form'|trans({}, 'ui')) }}</p>
    {% endif %}

    {{ parent() }}
{% endblock main %}
