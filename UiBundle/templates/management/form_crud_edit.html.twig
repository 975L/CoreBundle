{% extends '@EasyAdmin/crud/edit.html.twig' %}

{% block main %}
    {# The language the form is being written in. Nothing at all on a site declaring a single one, which is every c975L site until it says otherwise #}
    {% if form_content_locales|default([]) is not empty %}
        <ul class="nav nav-pills mb-3">
            {# Each language named in its own, the way the back office's own language menu names them #}
            <li class="nav-item">
                <a class="nav-link{{ form_content_locale is null ? ' active' : '' }}" href="{{ form_content_urls[''] }}">{{ form_default_locale|locale_name(form_default_locale) }}</a>
            </li>
            {% for locale in form_content_locales %}
                <li class="nav-item">
                    <a class="nav-link{{ locale == form_content_locale ? ' active' : '' }}" href="{{ form_content_urls[locale] }}">{{ locale|locale_name(locale) }}</a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if form_content_locale is defined and form_content_locale is not null %}
        <p class="text-muted">{{ 'label.form_translation_help'|trans({}, 'ui') }}</p>
    {% else %}
        <p>{{ ('label.info_form'|trans({}, 'ui')) }}</p>
    {% endif %}

    {{ parent() }}
{% endblock main %}
