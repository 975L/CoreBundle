{# Static usage: <twig:c975LUi:Collection:Grid items="{{ [...] }}" [eyebrow=""] [title=""] [linkLabel=""] [linkUrl=""] [variant=""] [background=""] [id=""]/> #}
{# Dynamic usage (Block system): see templates/blocks/Collection.html.twig #}
{# Each "items" entry is already-rendered HTML; the "portfolio" variant borrows PortfolioGrid's grid so it matches a real one on the same page #}
{% set isPortfolio = variant is defined and variant == 'portfolio' %}

{# The same head in both variants: the block's form offers eyebrow and the "see all" link whatever the presentation, and dropping them for the default one left the editor filling in fields that never showed up #}
{% set eyebrow = eyebrow|default('') %}
{% set title = title|default('') %}
{% set linkLabel = linkLabel|default('') %}
{% set linkUrl = linkUrl|default('') %}

{# A headingless <section> is invalid HTML, and a head reduced to its link carries no heading #}
{% set hasHeading = title or eyebrow %}
{% set tag = hasHeading ? 'section' : 'div' %}
{# Matched, not interpolated: the value comes from stored block data and must not write any class name #}
{% set background = background|default('') in ['muted', 'primary', 'dark'] ? ' section--bg-' ~ background : '' %}
<{{ tag }} class="collection-grid{{ isPortfolio ? ' collection-grid--portfolio' : '' }}{{ background }}"{% if id is defined and id %} id="{{ id }}"{% endif %}>
    <div class="section-wrap">
        {% if hasHeading or (linkLabel and linkUrl) %}
            <div class="{{ isPortfolio ? 'portfolio-grid__head' : 'collection-grid__head' }}">
                <div>
                    {% if title %}
                        {% if eyebrow %}<p class="section-eyebrow">{{ eyebrow }}</p>{% endif %}
                        <h2 class="section-title">{{ title }}</h2>
                    {% elseif eyebrow %}
                        <h2 class="section-eyebrow">{{ eyebrow }}</h2>
                    {% endif %}
                </div>
                {% if linkLabel and linkUrl %}<a class="section-btn section-btn--ghost" href="{{ linkUrl }}">{{ linkLabel }}</a>{% endif %}
            </div>
        {% endif %}
        <div class="{{ isPortfolio ? 'portfolio-grid__grid' : 'cards' }}">
            {% for html in items %}
                {{ html|raw }}
            {% endfor %}
        </div>
    </div>
</{{ tag }}>
