{# <twig:c975LUi:Video:Iframe src="your-url" [title="optional title"] [description="optional description"] [class="your-css-classes"] [width="auto"] [height="auto"]/> #}
{# The real <iframe> is created client-side behind cookie consent, so this markup stays cacheable #}
<figure class="video-iframe-figure">
    {% if title is defined and title %}<h3 class="video-iframe-title">{{ title }}</h3>{% endif %}
    {# "videoiframe-*", not "video-iframe-*": Stimulus doesn't dasherize the identifier, only the value name #}
    <div class="img img-responsive {{ class|default([])|join(' ') }} video-iframe-consent"
         data-controller="videoIframe"
         data-videoiframe-src-value="{{ src }}"
         data-videoiframe-title-value="{{ title|default('') }}"
         data-videoiframe-width-value="{{ width|default('') }}"
         data-videoiframe-height-value="{{ height|default('') }}">
        <div data-videoiframe-target="placeholder" class="video-iframe-placeholder">
            <p>{{ 'label.video_iframe_consent_required'|trans({}, 'ui') }}</p>
            <button type="button" class="btn btn-primary" data-action="videoIframe#accept">
                {{ 'label.video_iframe_accept'|trans({}, 'ui') }}
            </button>
        </div>
    </div>
    {% if description is defined and description %}<figcaption class="video-iframe-description text">{{ description|raw }}</figcaption>{% endif %}
</figure>
