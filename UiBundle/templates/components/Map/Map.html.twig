{# <twig:c975LUi:Map:Map points="[{label, latitude, longitude, text, url, icon}]" [title="optional title"] [id="anchor"] [height="medium"] [zoom="13"] [list="full"]/> #}
{# "list" says how the places read under the map: "full" writes them all out, "select" hands them to the browser's own picker, where a name is reached by typing its first letters - what a listing of dozens of places needs, the full list being a page of its own #}
{# "icon" is optional, the url of the image that one marker is drawn with - for a listing whose places are of several sorts and whose map is read by telling them apart; a point naming none keeps the bundle's own pin #}
{# The list of places is the content, and the map is what the browser makes of it: a visitor with no JavaScript, a browser that never got the library, or a Google map left without its key all keep the addresses and their links, which is also what a crawler reads #}
{% set settings = ui_map_settings() %}
{# Filtered and renumbered in PHP (see MapExtension::points): a point with no coordinates has nowhere to be drawn, and Twig's own filter would keep the original keys - which encodes the payload as a JSON object the controller reads as no points at all #}
{% set points = ui_map_points(points|default([])) %}
{% if points is not empty %}
    <section class="ui-map ui-map--{{ height|default('medium') }}"{% if id is defined and id %} id="{{ id }}"{% endif %}>
        {% if title is defined and title %}<h2 class="ui-map__title">{{ title }}</h2>{% endif %}
        {# Kebab-case identifier on both sides: Stimulus doesn't dasherize the identifier, only the value name #}
        {# Cached with the block (see MapCacheTagProvider): nothing here depends on who is looking. Why a map is missing is told by the controller alone, from the sentences the layout hands whoever may act on it (see _diagnostic.html.twig) #}
        <div class="ui-map__frame"
             data-controller="ui-map"
             data-ui-map-usable-value="{{ settings.usable ? 'true' : 'false' }}"
             {% if settings.usable %}
                 data-ui-map-provider-value="{{ settings.provider }}"
                 {# What the provider's driver draws with (see MapProviderInterface::getSettings()): a tile server and this bundle's own copy of Leaflet, or a browser key #}
                 data-ui-map-settings-value="{{ settings.settings|json_encode }}"
                 data-ui-map-needs-consent-value="{{ settings.needsConsent ? 'true' : 'false' }}"
                 data-ui-map-zoom-value="{{ zoom|default(13) }}"
                 data-ui-map-points-value="{{ points|json_encode }}"
             {% endif %}>
            {# Filled by the controller once the library is there - left empty and out of the flow otherwise, the list below being what the visitor reads #}
            <div class="ui-map__canvas" data-ui-map-target="canvas" hidden></div>
            {# Why the map is not there, in place and at once, for whoever placed the block - a health check is read by somebody who went looking, and the person who has just chosen a provider is looking at the page. Left empty and hidden for a visitor: a missing key and a security policy are not theirs to fix, and the list of places is the content either way #}
            <p class="ui-map__diagnostic" data-ui-map-target="diagnostic" hidden></p>
            {# Consent still to be given, for a provider that costs one: shown by the controller, never on a map drawn from tiles that write no cookie #}
            <div class="ui-map__prompt" data-ui-map-target="consent" hidden>
                <p>{{ 'label.map_consent_required'|trans({}, 'ui') }}</p>
                <button type="button" class="btn btn-primary" data-action="ui-map#accept">{{ 'label.map_accept'|trans({}, 'ui') }}</button>
            </div>
            {# Every place in a one-line control, picking one bringing the map onto its marker: rendered hidden and revealed by the controller, the list below staying the content. The value is the place's rank among the points, the only thing that names a marker #}
            {% if 'select' == list|default('full') %}
                <select class="ui-map__select" data-ui-map-target="select" data-action="change->ui-map#locate" aria-label="{{ 'label.map_choose_place'|trans({}, 'ui') }}" hidden>
                    <option value="">{{ 'label.map_choose_place'|trans({}, 'ui') }}</option>
                    {% for point in points %}
                        <option value="{{ loop.index0 }}">{{ point.label }}{% if point.text is defined and point.text %} - {{ point.text }}{% endif %}</option>
                    {% endfor %}
                </select>
            {% endif %}
            <ul class="ui-map__list" data-ui-map-target="list">
                {% for point in points %}
                    <li class="ui-map__place">
                        {% if point.url is defined and point.url %}
                            <a href="{{ point.url }}">{{ point.label }}</a>
                        {% else %}
                            <span class="ui-map__place-label">{{ point.label }}</span>
                        {% endif %}
                        {% if point.text is defined and point.text %}<span class="ui-map__place-text">{{ point.text }}</span>{% endif %}
                        {# The place on the provider's own map, coordinates and all - the one link that works whether or not this page ever drew a map of its own #}
                        <a class="ui-map__place-link" href="{{ ui_map_place_url(point) }}" target="_blank" rel="noopener">{{ 'label.map_see_on_map'|trans({}, 'ui') }}</a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>
{% endif %}
