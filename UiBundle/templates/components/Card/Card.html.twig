{# Static usage: <twig:c975LUi:Card:Card id="id" title="Title" [titleUrl=""] [titleAside=""] [level="h2"] [icon="{{ ['file.ext', 'css-classes', width, height] }}"] [lang=""]>Your content</twig:c975LUi:Card:Card> #}
{# "titleAside": a second mention at the right end of the band - a date, a price, a count. It reads as what qualifies the title, not as a title of its own, hence lighter and smaller rather than set apart by a rule #}
{# The title is only wrapped in a span of its own when there is a mention beside it: a band carrying nothing else keeps the markup it has always had, which is what the sites styling ".card-header > a" are written against #}
{# "stat" variant: add any of [src=""] [alt=""] [eyebrow=""] [rating=""] [stats="{{ [{label: 'Int.', value: 900}] }}"] and the card opens on a picture, then a qualifying line, a score and a row of key figures, whatever is nested coming after them. A card given none of the five is exactly the card it always was #}
{# Every attribute the card reads is declared here, so what is left in "attributes" is what the caller added on top - data-theme first of all, which opens a second color ambiance on this card alone (sass/_tokens.scss declares the tokens on ":root, [data-theme]") #}
{# Declared rather than rendered through attributes.defaults(): id/class/lang keep the hand-written conditions below, an empty id="" passed by a caller being invalid HTML the component has always dropped #}
{% props
    title,
    id = "",
    titleUrl = "",
    titleAside = "",
    level = "",
    icon = "",
    lang = "",
    class = "",
    dataAnimation = "",
    content = "",
    src = "",
    alt = "",
    width = "",
    height = "",
    eyebrow = "",
    rating = "",
    stats = [],
    tag = "div"
%}
{# id/data-animation only written when actually set, same as every other component here - an empty id="" is invalid HTML (and every card after the first a "duplicate ID" on top of it), and animate-scroll.js reads data-animation as the class name to add, so an empty one is nothing to animate anyway #}
{# The variant declares itself by its own props, no "variant" string to keep in step with them #}
{% set isStat = src or eyebrow or rating != "" or stats|length %}
{# The element the card is drawn as. Set by the calling template and by nothing else - no form offers it, no editor sees it: the component is handed a title and some content, which says nothing of what the card stands for, where the template drawing it knows. "article" for a card standing for one self-contained thing (a book, a lot, an item of a source), "section" for one part of the page holding it, and "div" - the default - for a panel that is neither, which is what every caller written before this prop asks for #}
{# Matched and never interpolated all the same, the same rule as "background" and "variant": nothing must be able to write a tag name into the markup #}
{% set tag = tag|default('div') in ['article', 'section'] ? tag : 'div' %}
<{{ tag }} class="card box-shadow{{ isStat ? " card--stat" : "" }} {{ class }}"{% if id %} id="{{ id }}"{% endif %}{% if dataAnimation %} data-animation="{{ dataAnimation }}"{% endif %}{% if lang %} lang="{{ lang }}"{% endif %}{{ attributes }}>
    {# "length" and not != "": an empty icon reaches the card as [] as often as "" (Section:Features passes [] when its card has no icon), and [] != "" is true in Twig, which sent the card reading icon[0] on an empty array #}
    {% if icon|length %}
        <{{ level|default('h2') }} class="card-header">{% if titleAside %}<span class="card-header__title">{% endif %}<twig:c975LUi:Image:Icon src="{{ icon[0] }}" class="{{ icon[1] }}" width="{{ icon[2] }}" height="{{ icon[3] }}"/> {% if titleUrl %}<a href="{{ titleUrl }}">{{ title }}</a>{% else %}{{ title }}{% endif %}{% if titleAside %}</span><span class="card-header__aside">{{ titleAside }}</span>{% endif %}</{{ level|default('h2') }}>
    {% else %}
        <{{ level|default('h2') }} class="card-header">{% if titleAside %}<span class="card-header__title">{% endif %}{% if titleUrl %}<a href="{{ titleUrl }}">{{ title }}</a>{% else %}{{ title }}{% endif %}{% if titleAside %}</span><span class="card-header__aside">{{ titleAside }}</span>{% endif %}</{{ level|default('h2') }}>
    {% endif %}
    <div class="card-body">
        {% if src %}
            {# Linked to the card's own destination when it has one, so the picture is not a dead zone in the middle of a clickable card #}
            <twig:c975LUi:Image:Link src="{{ src }}" url="{{ titleUrl }}" alt="{{ alt|default(title) }}" width="{{ width }}" height="{{ height }}"/>
        {% endif %}
        {% if isStat %}
            <div class="card-data">
                {% if eyebrow %}<p class="card-eyebrow">{{ eyebrow }}</p>{% endif %}
                {# "" and not null: a rating of 0 is a real score - "not rated" is the field left empty #}
                {% if rating != "" %}<twig:c975LUi:Progress:Rating value="{{ rating }}"/>{% endif %}
                {% if stats|length %}
                    <ul class="card-stats">
                        {# The column is counted here rather than read in CSS, no selector telling which column a cell falls in: a full-width figure always opens a fresh line, so the counter restarts behind it and the next one falls back on the left #}
                        {% set column = 0 %}
                        {% for stat in stats %}
                            {% set wide = stat.wide|default(false) %}
                            {% set column = wide ? 0 : (1 == column ? 2 : 1) %}
                            {# A figure with no neighbour to share its line - the last one, or the one a wide figure follows - takes the line whole, an odd count otherwise reading off-center #}
                            {% set alone = 1 == column and (loop.last or stats[loop.index].wide|default(false)) %}
                            {# "wide" on a figure spelled out in words: it takes the whole line, half a column breaking a long word under its own label #}
                            <li class="card-stats-item{{ wide or alone ? ' card-stats-item--wide' : (1 == column ? ' card-stats-item--end' : '') }}">
                                <span class="card-stats-label">{{ stat.label }}</span>
                                <strong class="card-stats-value">{{ stat.value }}</strong>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endif %}
        {# Declared as a prop rather than left to exist or not: a card called self-closing nests nothing, and a bare "content" raised an error where a card reduced to its title is a perfectly legitimate call #}
        {% block content %}{{ content|raw|nl2br }}{% endblock %}
    </div>
</{{ tag }}>
