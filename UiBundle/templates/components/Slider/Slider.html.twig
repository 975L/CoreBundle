{# Static usage : <twig:c975LUi:Slider:Slider media="{{ mediaList }}" id="id" duration="5000" [ratio="free"] [class=""] [label=""] [fallbackAlt=""] /> #}
{# Rich usage (clickable title/text per slide) : <twig:c975LUi:Slider:Slider slides="{{ [{image: media, title: '', text: '', url: ''}, ...] }}" id="id" duration="5000" /> #}
{# Add imageLinksToUrl="true" to also make the image itself link to slide.url instead of advancing to the next slide #}
{# Add layout="freeflow" for a full-bleed carousel: every slide stays visible side by side and overflows past the viewport's left/right edges, no horizontal scrollbar #}
{% set label = label|default("label.pages_gallery"|trans({}, "ui")) %}
{# What a slide is described as when its own media carries nothing: the caller names what the gallery shows ("fallbackAlt"), and a media whose alternative text was typed in the back-office always wins over it. Without it a gallery of a hundred pages publishes a hundred empty alt attributes - invisible to Google Images, and silent to a screen reader #}
{% set fallbackAlt = fallbackAlt|default('') %}
{% set class = class|default([])|join(' ') %}
{% set ratio = ratio|default("free") %}
{% set layout = layout|default("default") %}
{% set slides = slides|default([]) %}
{% set imageLinksToUrl = imageLinksToUrl|default(false) %}
{% set mediaList = slides|length > 0 ? slides|map(slide => slide.image) : media|default([]) %}
{% if mediaList|length == 1 %}
    {% set media = mediaList[0] %}
    {% set mediaAlt = media.alt ?: fallbackAlt %}
    {% set slide = slides[0]|default(null) %}
    {% set isVideo = media.mimeType starts with 'video' %}
    {# The credits and the rights mention are laid over the media, so a media shown on its own needs a containing block of its own: without one they would anchor to whatever positioned ancestor the page happens to carry. Sized to its content, so the band spans the media and not the column - a portrait scan in a wide column would otherwise wear a band twice its width #}
    <div class="slider-single-media">
    {% if slide and (slide.title or slide.text) %}
        <div class="slider-single {{ class }}">
            {% set mediaTag %}
                {% if isVideo %}
                    <video class="img-responsive img-rounded box-shadow" controls muted loop playsinline preload="metadata" aria-label="{{ mediaAlt }}"><source src="{{ vich_uploader_asset(media) }}" type="{{ media.mimeType }}"></video>
                {% else %}
                    <twig:c975LUi:Image:Image imgSrc="{{ vich_uploader_asset(media) }}" alt="{{ mediaAlt }}" label="{{ media.label }}" class="img-responsive img-rounded box-shadow" width="{{ media.width }}" height="{{ media.height }}" above="{{ media.above }}" />
                {% endif %}
            {% endset %}
            {% if imageLinksToUrl and slide.url and not isVideo %}
                <a href="{{ slide.url }}" class="slider-img-link">{{ mediaTag|raw }}</a>
            {% else %}
                {{ mediaTag|raw }}
            {% endif %}
            {% if slide.title %}<p class="slider-title">{% if slide.url %}<a href="{{ slide.url }}">{{ slide.title }}</a>{% else %}{{ slide.title }}{% endif %}</p>{% endif %}
            {% if slide.text %}<p class="slider-text">{% if slide.url %}<a href="{{ slide.url }}">{{ slide.text }}</a>{% else %}{{ slide.text }}{% endif %}</p>{% endif %}
        </div>
    {% elseif isVideo %}
        <video class="{{ ('img-responsive img-rounded box-shadow ' ~ class ~ ' ' ~ media.cssClasses|join(' '))|trim }}" controls muted loop playsinline preload="metadata" aria-label="{{ mediaAlt }}"><source src="{{ vich_uploader_asset(media) }}" type="{{ media.mimeType }}"></video>
    {% else %}
        <twig:c975LUi:Image:Image imgSrc="{{ vich_uploader_asset(media) }}" alt="{{ mediaAlt }}" label="{{ media.label }}" class="{{ ('img-responsive img-rounded box-shadow ' ~ class ~ ' ' ~ media.cssClasses|join(' '))|trim }}" width="{{ media.width }}" height="{{ media.height }}" above="{{ media.above }}" />
    {% endif %}
    {# The same two mentions the slides below carry: a media shown alone loses neither its credit nor its rights notice, which is what a license asking for attribution rests on #}
    {% if media.rightsReserved %}
        <p class="slider-rights-reserved">{{ "label.all_rights_reserved"|trans({}, "ui") }}</p>
    {% endif %}
    {% if media.credits %}
        <p class="slider-credits">{{ "label.credits"|trans({}, "ui") }} : {{ media.credits }}</p>
    {% endif %}
    </div>
{% elseif mediaList|length > 1 %}
    {# Named by aria-label rather than by a hidden heading: an <h3> under a page's <h1> skips level 2, a validation error on every page carrying a slider, for a title nobody reads - aria-label names the region just as well and leaves nothing in the outline #}
    <section id="{{ id }}" class="slider {{ layout == "freeflow" ? "slider-freeflow" : "" }} {{ ratio != "free" ? "slider-ratio-" ~ ratio : "" }} {{ class }}" aria-label="{{ label|default("Image slider") }}" data-controller="slider" data-slider-id="{{ id }}" data-slider-duration="{{ duration|default(0) }}">
        <ul class="slider-list">
        {% for slideMedia in mediaList %}
            {% set slide = slides[loop.index0]|default(null) %}
            {% set isVideo = slideMedia.mimeType starts with 'video' %}
            {% set slideAlt = slideMedia.alt ?: fallbackAlt %}
            {# Freeflow shows every slide at once, so lazy would leave the peeking ones blank #}
            {% set isEager = loop.first or layout == "freeflow" %}
            <li class="slider-item{% if loop.first and layout != "freeflow" %} slider-item-active{% endif %}"{% if not loop.first and layout != "freeflow" %} aria-hidden="true"{% endif %}>
                {% set img %}
                    {% if isVideo %}
                        <video class="slider-img slider-video img-responsive img-rounded box-shadow {{ slideMedia.cssClasses|join(' ') }}" controls muted loop playsinline preload="{{ isEager ? "auto" : "metadata" }}" aria-label="{{ slideAlt }}"><source src="{{ vich_uploader_asset(slideMedia) }}" type="{{ slideMedia.mimeType }}"></video>
                    {% else %}
                        <img src="{{ vich_uploader_asset(slideMedia) }}" alt="{{ slideAlt }}" class="slider-img img img-responsive img-rounded box-shadow {{ slideMedia.cssClasses|join(' ') }}" width="{{ slideMedia.width }}" height="{{ slideMedia.height }}" loading="{{ isEager ? "eager" : "lazy" }}">
                    {% endif %}
                {% endset %}
                {% if imageLinksToUrl and slide and slide.url and not isVideo %}<a href="{{ slide.url }}" class="slider-img-link">{{ img|raw }}</a>{% else %}{{ img|raw }}{% endif %}
                {% if slide and slide.title %}
                    <p class="slider-title">{% if slide.url %}<a href="{{ slide.url }}">{{ slide.title }}</a>{% else %}{{ slide.title }}{% endif %}</p>
                {% endif %}
                {% if slide and slide.text %}
                    <p class="slider-text">{% if slide.url %}<a href="{{ slide.url }}">{{ slide.text }}</a>{% else %}{{ slide.text }}{% endif %}</p>
                {% endif %}
                {% if slideMedia.rightsReserved %}
                    <p class="slider-rights-reserved">{{ "label.all_rights_reserved"|trans({}, "ui") }}</p>
                {% endif %}
                {% if slideMedia.credits %}
                    <p class="slider-credits">{{ "label.credits"|trans({}, "ui") }} : {{ slideMedia.credits }}</p>
                {% endif %}
            </li>
        {% endfor %}
        </ul>
        <div class="slider-controls">
            <button type="button" class="slider-button slider-prev" aria-label="{{ "label.previous_slide"|trans({}, "ui") }}">
                <img src="{{ asset("bundles/c975lsite/icons/angle-left.svg") }}" alt="" aria-hidden="true" class="angle" width="32">
            </button>
            <button type="button" class="slider-button slider-next" aria-label="{{ "label.next_slide"|trans({}, "ui") }}">
                <img src="{{ asset("bundles/c975lsite/icons/angle-right.svg") }}" alt="" aria-hidden="true" class="angle" width="32">
            </button>
            {% if duration|default(0) > 0 %}
                <button type="button" class="slider-play-pause" data-action="stop" aria-label="{{ "label.stop_animation"|trans({}, "ui") }}">
                    <span aria-hidden="true">⏸</span>
                </button>
            {% endif %}
        </div>

        <ul class="slider-dots" aria-label="{{ "label.slide_navigation"|trans({}, "ui") }}">
            {% for slideMedia in mediaList %}
                <li>
                    <button type="button" class="slider-dot{% if loop.first %} current active{% endif %}" data-slide="{{ loop.index0 }}" aria-label="{{ "label.slide"|trans({}, "ui") }} {{ loop.index }}{% if loop.first %} ({{ "label.current"|trans({}, "ui") }}){% endif %}">
                        <span aria-hidden="true">{{ loop.index }}</span>
                    </button>
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
