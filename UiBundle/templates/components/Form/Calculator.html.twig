{# Static usage  : render(controller('c975L\\UiBundle\\Controller\\FormController::fragment', {'name': 'economies-e85'})) #}
{# Dynamic usage : {{ render_block(block) }} — via FormBlock.html.twig, a calculator being a Form like any other #}
{% trans_default_domain 'ui' %}

{# Given an action, the calculator is also sent like any other Form, its results travelling with it - with none, it posts nowhere, and a form element around it would let Enter submit it to the page's own URL #}
{% set submittable = uiForm.action is not null %}

{# The results are already right when this renders (computed from the fields' own defaults), so a visitor with no JavaScript reads real numbers rather than empty slots — the controller below only keeps them in step as the inputs move #}
<div class="ui-form-block ui-calculator{{ uiForm.outputsFirst ? ' ui-calculator-outputs-first' }}"
     data-controller="ui-calculator"
     data-ui-calculator-url-value="{{ path('ui_form_compute', {'name': uiForm.name, '_locale': app.request ? app.request.locale : null}) }}">
    {# "display: contents" (sass/_calculator.scss): the form element stays out of the grid, the fields and the results remaining its two columns #}
    {% if submittable %}
        {{ form_start(form, {'action': path('ui_form_submit', {'name': uiForm.name}), 'attr': {'data-turbo': 'false', 'class': 'ui-calculator-form'}}) }}
    {% endif %}

    <div class="ui-calculator-fields">
        {{ form_widget(form) }}
    </div>

    <div class="ui-calculator-results" data-ui-calculator-target="results" aria-live="polite">
        {% for output in uiForm.visibleOutputs %}
            <div class="ui-calculator-result{{ output.highlighted ? ' ui-calculator-result-highlighted' }}">
                <span class="ui-calculator-result-label">{{ ui_form_label(output) }}</span>
                <span class="ui-calculator-result-value" data-ui-calculator-output="{{ output.name }}">
                    {{ results[output.name].formatted ?? '—' }}
                </span>
            </div>
        {% endfor %}
    </div>

    <p class="text-muted small">
        {{ 'text.calculator_estimate'|trans }}
    </p>

    {% if submittable %}
        {# Under both columns: what the action answered after the redirect, next to the button that sent it #}
        <div class="ui-calculator-submit">
            {% include '@c975LUi/components/Form/_flashes.html.twig' %}
            {% include '@c975LUi/components/Form/_submit.html.twig' %}
        </div>
        {{ form_end(form) }}
    {% elseif uiForm.links is not empty %}
        {# Admin-defined, stored on the Form itself — same links a submittable Form shows under its button #}
        <p class="mt-2">
            {% for link in uiForm.links %}
                <a href="{{ link.url }}">{{ link.label }}</a>{{ not loop.last ? ' · ' }}
            {% endfor %}
        </p>
    {% endif %}
</div>
