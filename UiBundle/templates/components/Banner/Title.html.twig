{# <twig:c975LUi:Banner:Title title="Title" [level="h2"] [src="your-path/file.ext"] [alt=""] [height="small|medium|large"]/> #}
{% set level = level|default('h2') %}
{% set imgSrc = src is defined and src ? asset(src) : '' %}
{# Matched against the closed list, not interpolated: the value comes from stored block data and must not write any class name (same rule as the flip card's ratio). Empty declares none, and the banner keeps the floor the stylesheet sets. See BannerTitleType::HEIGHT_CHOICES, whose values these are #}
{% set heightClass = height|default('') in ['small', 'medium', 'large'] ? 'banner-title--height-' ~ height : '' %}
<div class="banner-title {{ heightClass }}">
    {# A real image rather than a background: the picture is what the block holds, so it carries its own alt instead of the role="img"/aria-label a background has to be described through - and being per-instance, a background url is a value no class can carry, which under a nonced style-src took a <style> element the HTML spec allows nowhere but the <head>. Laid over the whole banner and cropped exactly as that background was (see sass/_banner-title.scss) #}
    {% if imgSrc %}<img src="{{ imgSrc }}" alt="{{ alt|default('') }}" class="banner-title-img">{% endif %}
    <div class="banner-title-overlay">
        <{{ level }} class="banner-title-text">{{ title }}</{{ level }}>
    </div>
</div>
