{# The published reviews of one thing, drawn on that thing's own page by the "reviews" Twig function (see ReviewRuntime) #}
{# Each review is drawn by the very card the "collection" block uses for the review wall, so the two never drift apart #}
{% trans_default_domain 'ui' %}
<section class="reviews">
    <h2>{{ 'label.reviews'|trans }}</h2>

    {% if reviews is empty %}
        <p class="text">{{ 'label.reviews_empty'|trans }}</p>
    {% else %}
        <div class="reviews-list">
            {% for review in reviews %}
                {% include '@c975LUi/collection/ReviewItem.html.twig' with {
                    title: review.title,
                    content: review.description,
                    imageUrl: review.imageUrl,
                    url: review.url,
                }|merge(review.data) only %}
            {% endfor %}
        </div>
    {% endif %}

    {# The form opens here rather than on a page of its own, and is fetched only once the fold is opened: the sheet around it carries no session and no cookie, and a visitor who never writes a review is served none (see assets/js/review-form.js) #}
    {# Without javascript the summary is a plain link to that same url, which then answers with the whole page #}
    {% set formUrl = ui_review_url(ownerType, ownerId) %}
    <details class="review-form"
             data-controller="ui-review-form"
             data-ui-review-form-url-value="{{ formUrl }}"
             data-ui-review-form-error-label-value="{{ 'label.review_form_error'|trans }}">
        <summary class="review-form-summary">
            <a href="{{ formUrl }}" data-ui-review-form-target="link">{{ 'label.review_form_submit_link'|trans }}</a>
        </summary>
        <div data-ui-review-form-target="panel"></div>
    </details>
</section>
