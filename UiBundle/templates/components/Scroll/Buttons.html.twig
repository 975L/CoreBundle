{# <twig:c975LUi:Scroll:Buttons/> #}
{# The two buttons a long page is walked with, pulling to its top and to its bottom. They are ordinary anchors, working without javascript: the layout rendering them carries an "id=top" on its body and a "span id=bottom" as its last element (see @c975LUi/layout.html.twig), which is what they point at #}
<div data-controller="scrollButtons">
    <a href="#top" class="backTop" aria-label="{{ 'label.top'|trans({}, 'ui') }}" data-scrollButtons-target="top">{{ 'label.top'|trans({}, 'ui') }}</a>
    <a href="#bottom" class="pullDown" aria-label="{{ 'label.bottom'|trans({}, 'ui') }}" data-scrollButtons-target="bottom"></a>
</div>
