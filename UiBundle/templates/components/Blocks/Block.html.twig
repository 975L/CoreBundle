{# Re-checked, not trusted from the caller: is_granted() is an in-memory check, no extra query #}
{% set canEditBlock = editUrl is defined and editUrl is not empty and is_granted(config('site-role-editor')) %}
{# Only the editor's own overlay is wrapped here. The entrance animation used to be too, which is why a slot of a container kind never played one: a slot is rendered by render_block() straight, never through this component - it is written by BlockExtension::renderBlock() now, on every path #}
{% if canEditBlock %}
    <div class="block-editable" data-block-id="{{ block.id }}" data-block-edit-url="{{ editUrl }}">{{ render_block(block) }}</div>
{% else %}
    {{ render_block(block) }}
{% endif %}
