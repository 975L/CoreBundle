{# Consecutive card blocks are wrapped in a ".cards" flex row, else they stack instead of lining up. "flip_card" counts as one: it is the same measure and the same box (see sass/_flip-card.scss), so the two mix in one row #}
{% set cardKinds = ['card', 'flip_card'] %}
{% set kinds = blocks|map(b => b.kind) %}
{# Editor-only: resolving edit URLs runs a query nobody else would see the result of #}
{% set canEditBlocks = is_granted(config('site-role-editor')) %}
{% set editUrls = canEditBlocks ? block_edit_urls(blocks) : [] %}
{# Connects the animateScroll controller once per page; display:contents keeps it out of the layout #}
<div class="blocks" data-controller="animateScroll{{ canEditBlocks ? ' blockEditOverlay' : '' }}"{% if canEditBlocks %} data-edit-label="{{ 'label.edit'|trans({}, 'ui') }}"{% endif %}>
    {% for block in blocks %}
        {% set isCard = block.kind in cardKinds %}
        {% set prevIsCard = loop.index0 > 0 and kinds[loop.index0 - 1] in cardKinds %}
        {% set nextIsCard = not loop.last and kinds[loop.index0 + 1] in cardKinds %}
        {% if isCard and not prevIsCard %}<div class="cards">{% endif %}
        <twig:c975LUi:Blocks:Block block="{{ block }}" editUrl="{{ editUrls[block.id] ?? null }}"/>
        {% if isCard and not nextIsCard %}</div>{% endif %}
    {% endfor %}
</div>
