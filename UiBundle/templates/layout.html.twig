{# Page shell for an app running Config+Ui plus a satellite bundle (shop, book, gallery...) with no site foundation on top - SiteBundle's own layout, with its navbar, footer, menus and per-Page SEO, takes over whenever it is installed (see the scaffolded templates/layout.html.twig, which extends whichever of the two exists). Everything below is what a site genuinely cannot go live without and that no longer depends on having pages: the theme, the site graphics, the share tags, the fonts, the cookie banner #}
{% if site_media('logo') is not null %}
    {% set logo = absolute_url(asset('/' ~ site_media('logo').filename)) ~ (site_media('logo').updatedAt ? '?v=' ~ site_media('logo').updatedAt.timestamp : '') %}
{% endif %}
{% if site_media('favicon') is not null %}
    {% set favicon = absolute_url(asset('/' ~ site_media('favicon').filename)) ~ (site_media('favicon').updatedAt ? '?v=' ~ site_media('favicon').updatedAt.timestamp : '') %}
{% endif %}
{% if site_media('apple-touch-icon') is not null %}
    {% set appleTouchIcon = absolute_url(asset('/' ~ site_media('apple-touch-icon').filename)) ~ (site_media('apple-touch-icon').updatedAt ? '?v=' ~ site_media('apple-touch-icon').updatedAt.timestamp : '') %}
{% endif %}

{# What the url says of itself when no entity carries it - a listing, a filtered listing, a tool page (see ConfigBundle's UrlMetadata). Read only for what the rendering template left unsaid: a book, a product, a photo state their own from their entity, and that always wins #}
{% set urlMetadata = url_metadata() %}
{% if urlMetadata is not null %}
    {% if title is not defined or title == '' %}
        {% set title = urlMetadata.title %}
    {% endif %}
    {% if summarySocialNetwork is not defined or summarySocialNetwork is empty %}
        {% set summarySocialNetwork = urlMetadata.summarySocialNetwork %}
    {% endif %}
{% endif %}

{# ogImage: whatever the rendering template set, then the url's own row, then the site's default og-image, then the logo - same order as SiteBundle's layout, minus the per-Page override it has and this one can't #}
{# The media is kept alongside the url, the dimensions and the alternative text being columns of the media library - null when the rendering template set the image itself, which then says what it shows under "ogImageAlt" #}
{% set ogImageMedia = null %}
{% if ogImage is not defined or ogImage == null %}
    {% if urlMetadata is not null and urlMetadata.ogImage is not null %}
        {% set ogImageMedia = urlMetadata.ogImage %}
    {% elseif site_media('og-image') is not null %}
        {% set ogImageMedia = site_media('og-image') %}
    {% elseif site_media('logo') is not null %}
        {% set ogImageMedia = site_media('logo') %}
    {% endif %}

    {# The url written once for the three of them, where each branch used to repeat it #}
    {% if ogImageMedia is not null %}
        {% set ogImage = absolute_url(asset('/' ~ ogImageMedia.filename)) ~ (ogImageMedia.updatedAt ? '?v=' ~ ogImageMedia.updatedAt.timestamp : '') %}
    {% endif %}
{% endif %}

{% set siteName = config('site-name') %}
{% set pageTitle = title is defined and title != '' ? (siteName ? title ~ ' - ' ~ siteName : title) : siteName %}

<!DOCTYPE html>
{# "auto" leaves data-theme unset, so prefers-color-scheme takes over #}
<html lang="{{ app.request.locale|default('en') }}"{% if config('theme-mode') in ['light', 'dark'] %} data-theme="{{ config('theme-mode') }}"{% endif %}>
    <head>
        {% block head %}
            {% block meta %}
                <meta charset="UTF-8">
                {# The comma is not optional: the viewport content is a comma-separated list, so "width=device-width initial-scale=1.0" is one single unparseable token and the whole directive is dropped #}
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                {# Turbo reads this to nonce the inline tags it re-executes, which the CSP would otherwise block #}
                <meta name="csp-nonce" content="{{ csp_nonce('script') }}">

                {# Nonces style-src on every page of this layout, not only on the ones rendering an inline <style> (the Banner component, say): a nonce present on a directive disables 'unsafe-inline' for it, so a rule varying page by page would break inline styles on those pages alone. The value itself is unused here, the call is what adds the nonce to the directive #}
                {% set styleNonce = csp_nonce('style') %}

                {# "noindex, follow" on every error page: "status_code" is only ever set by Symfony's error renderer, and a 404/500 rendered with this layout would otherwise inherit the "index, follow" default and invite search engines to index it #}
                <meta name="robots" content="{{ robots|default(status_code is defined and status_code >= 400 ? 'noindex, follow' : 'index, follow') }}">

                <title>{% block title %}{{ pageTitle }}{% endblock %}</title>
                <meta property="og:title" content="{{ pageTitle }}">
                <meta property="og:type" content="website">
                {% if siteName %}
                    <meta property="og:site_name" content="{{ siteName }}">
                {% endif %}
                {% if config('site-author') %}
                    <meta name="author" content="{{ config('site-author') }}">
                {% endif %}
                <meta name="copyright" content="{{ site_copyright() }}">
{# The page's own summary, stated by the template rendering it, under the very name SiteBundle's Page column and its own layout use. The two layouts are interchangeable - the scaffolded templates/layout.html.twig extends whichever exists - so they have to read the same variable: this one asked for "description" until 08/2026, and a site with SiteBundle installed lost the tag without a word. Nothing to do with the "description" the Video/Audio/Iframe components take, which is a caption #}
{# Reduced to plain text here, as SiteBundle's layout does: the summary comes from a rich-text column often enough (a Page's, a gallery category's) that a template feeding one raw would publish escaped markup as its description, and the filter leaves a summary already plain untouched #}
                {% if summarySocialNetwork is defined and summarySocialNetwork is not empty %}
                    <meta name="description" content="{{ summarySocialNetwork|plain_text }}">
                    <meta property="og:description" content="{{ summarySocialNetwork|plain_text|slice(0, 150) }}">
                {% endif %}
                {% if ogImage is defined %}
                    <meta property="og:image" content="{{ ogImage }}">
{# Stated only where they are known - the media library holds them as columns: a network reading them keeps the thumbnail's room before it is loaded, and guessing them would be worse than saying nothing #}
                    {% if ogImageMedia is not null and ogImageMedia.width and ogImageMedia.height %}
                        <meta property="og:image:width" content="{{ ogImageMedia.width }}">
                        <meta property="og:image:height" content="{{ ogImageMedia.height }}">
                    {% endif %}
{# What the image shows, for whoever is read the share rather than shown it. The template that set the image itself is the only one that knows, hence the "ogImageAlt" it may set next to it - otherwise it is the media's own alternative text #}
                    {% set ogImageAltText = ogImageAlt is defined and ogImageAlt is not empty ? ogImageAlt : (ogImageMedia is not null ? ogImageMedia.alt : null) %}
                    {% if ogImageAltText %}
                        <meta property="og:image:alt" content="{{ ogImageAltText }}">
                    {% endif %}
                {% endif %}

                {% set canonicalUrl = canonical_url() %}
                {% if canonicalUrl %}
                    <meta property="og:url" content="{{ canonicalUrl }}">
                    <link rel="canonical" href="{{ canonicalUrl }}">
                {% endif %}

                {% if favicon is defined %}
                    <link rel="icon" type="image/x-icon" href="{{ favicon }}">
                {% endif %}
                {% if appleTouchIcon is defined %}
                    <link rel="apple-touch-icon" href="{{ appleTouchIcon }}">
                    <link rel="apple-touch-icon-precomposed" href="{{ appleTouchIcon }}">
                {% endif %}
            {% endblock %}

            {# Matomo's origin, since this shell renders its snippet below: its script is fetched from a third-party host, so the DNS lookup and the TLS handshake would otherwise only start once that JS runs. Origin only, a preconnect must carry no path - and none at all when the instance is served by this very host, where the connection is already open. Gated on "site-enable-matomo" as the component itself is: a site whose tracking is off while its instance url stays filled would otherwise open a connection to a third party it never sends a measure to, which is exactly what turning the tracking off is meant to avoid. SiteBundle's own layout does the same, merging it into the "site-preconnect" list it offers on top #}
            {% block preconnect %}
                {% set matomoOrigin = config('site-enable-matomo') and config('site-matomo-url') ? config('site-matomo-url')|split('/')|slice(0, 3)|join('/') : '' %}
                {% if matomoOrigin and matomoOrigin != app.request.getSchemeAndHttpHost() %}
                    <link rel="preconnect" href="{{ matomoOrigin }}">
                {% endif %}
            {% endblock %}

            {# Before the stylesheets, the @font-face rules sitting inside them; crossorigin is required even same-origin #}
            {% block fontPreload %}
                {% for font in font_preloads() %}
                    <link rel="preload" href="{{ asset('/' ~ font.path) }}" as="font" type="{{ font.type }}" crossorigin>
                {% endfor %}
            {% endblock %}

            {# data-turbo-track="reload": Turbo Drive doesn't re-evaluate the <head> between navigations, so after a deployment a visitor already on the site would get the new HTML with the old assets. Marked this way, the tags are compared by Turbo on every navigation and a changed href triggers a full reload #}
            {% block stylesheets %}
                {% for stylesheet in bundle_stylesheets() %}
                    <link rel="stylesheet" href="{{ stylesheet }}" data-turbo-track="reload">
                {% endfor %}
            {% endblock %}

            {% block javascripts %}
                {% block importmap %}
                    {{ importmap(['app']|merge(bundle_scripts()), {'nonce': csp_nonce('script'), 'data-turbo-track': 'reload'}) }}
                {% endblock %}
            {% endblock %}
        {% endblock %}
    </head>

{# "id=top" and the "span id=bottom" closing the body are what the scroll buttons below point at #}
    <body id="top">
        {% block body %}
{# The two buttons a long page is walked with, ordinary anchors working without javascript #}
            <twig:c975LUi:Scroll:Buttons />
            <main>
                {# Before the flashes and outside their block: what debug mode held back is shown whichever page follows the send, a theme overriding the block below taking nothing of this over #}
                <twig:c975LUi:Email:DebugPreview />

                {% block flashes %}
                    {# Only a visitor who can hold a flash reads the bag: reading app.flashes starts the session, and it carries no such guard of its own. A theme overriding this block takes that reading over, hence the guard inside it #}
                    {% if ui_can_hold_flash() %}
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="flash alert alert-{{ label }} text-center" role="alert">{{ message|raw }}</div>
                            {% endfor %}
                        {% endfor %}
                    {% endif %}
                {% endblock %}

                {% block content %}{% endblock %}
            </main>

            {# Both carry their own "is it enabled" guard, so nothing to check here #}
            <twig:c975LUi:Analytics:Matomo />
            <twig:c975LUi:Cookie:Consent />
        {% endblock %}
        <span id="bottom"></span>
    </body>
</html>
