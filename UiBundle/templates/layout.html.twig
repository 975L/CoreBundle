{# The page shell every c975L site renders through, and the single source for the <head>: SiteBundle's layout extends this one and adds only what having Pages, menus and a navbar brings (see @c975LSite/layout.html.twig), so nothing below is written twice. The scaffolded templates/layout.html.twig extends whichever of the two exists #}
{# A child layout's top-level {% set %} runs before this template (Twig compiles the child's body ahead of the parent's yield), which is how SiteBundle hands over its entity-driven values - ogImageMedia, headingDisplayed, bodyClasses, bodyControllers - without this file knowing a single one of its entities #}
{% if site_media('logo') is not null %}
    {% set logo = absolute_url(asset('/' ~ site_media('logo').filename)) ~ (site_media('logo').updatedAt ? '?v=' ~ site_media('logo').updatedAt.timestamp : '') %}
{% endif %}
{% if site_media('favicon') is not null %}
    {% set favicon = absolute_url(asset('/' ~ site_media('favicon').filename)) ~ (site_media('favicon').updatedAt ? '?v=' ~ site_media('favicon').updatedAt.timestamp : '') %}
{% endif %}
{% if site_media('apple-touch-icon') is not null %}
    {% set appleTouchIcon = absolute_url(asset('/' ~ site_media('apple-touch-icon').filename)) ~ (site_media('apple-touch-icon').updatedAt ? '?v=' ~ site_media('apple-touch-icon').updatedAt.timestamp : '') %}
{% endif %}

{# What the url says of itself when no entity carries it - a listing, a filtered listing, a tool page (see ConfigBundle's UrlMetadata). Read only for what the rendering template left unsaid: a Page, a book, a product, a photo state their own from their entity, and that always wins #}
{% set urlMetadata = url_metadata() %}
{% if urlMetadata is not null %}
    {% if title is not defined or title == '' %}
        {% set title = urlMetadata.title %}
    {% endif %}
    {% if summarySocialNetwork is not defined or summarySocialNetwork is empty %}
        {% set summarySocialNetwork = urlMetadata.summarySocialNetwork %}
    {% endif %}
{% endif %}

{# ogImage: whatever the rendering template set, then what a child layout resolved from its own entity (SiteBundle hands over the Page's), then the url's own row, then the site's default og-image, then the logo #}
{# The media is kept alongside the url, the dimensions and the alternative text being columns of the media library - null when the rendering template set the image itself, which then says what it shows under "ogImageAlt" #}
{% if ogImageMedia is not defined %}
    {% set ogImageMedia = null %}
{% endif %}
{% if ogImage is not defined or ogImage == null %}
    {% if ogImageMedia is null %}
        {% if urlMetadata is not null and urlMetadata.ogImage is not null %}
            {% set ogImageMedia = urlMetadata.ogImage %}
        {% elseif site_media('og-image') is not null %}
            {% set ogImageMedia = site_media('og-image') %}
        {% elseif site_media('logo') is not null %}
            {% set ogImageMedia = site_media('logo') %}
        {% endif %}
    {% endif %}

    {# The url written once for the four of them, where each branch used to repeat it #}
    {% if ogImageMedia is not null %}
        {% set ogImage = absolute_url(asset('/' ~ ogImageMedia.filename)) ~ (ogImageMedia.updatedAt ? '?v=' ~ ogImageMedia.updatedAt.timestamp : '') %}
    {% endif %}
{% endif %}

{% set siteName = config('site-name') %}
{% set pageTitle = title is defined and title != '' ? (siteName ? title ~ ' - ' ~ siteName : title) : siteName %}

<!DOCTYPE html>
{# "auto" leaves data-theme unset, so prefers-color-scheme takes over #}
<html lang="{{ app.request.locale|default('en') }}"{% if config('theme-mode') in ['light', 'dark'] %} data-theme="{{ config('theme-mode') }}"{% endif %}>
    <head>
        {% block head %}
            {% block meta %}
                <meta charset="UTF-8">
                {# The comma is not optional: the viewport content is a comma-separated list, so "width=device-width initial-scale=1.0" is one single unparseable token and the whole directive is dropped #}
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                {# Without it iOS turns anything shaped like a number - a date, a reference, a price - into a phone link, restyling it and making it tappable #}
                <meta name="format-detection" content="telephone=no">

                {# Turbo reads this to nonce the inline tags it re-executes, which the CSP would otherwise block. It nonces its progress bar's own <style> with the very same value (see ProgressBar.createStylesheetElement), so the value has to be one style-src carries as well as script-src - hence both being asked for, in this order: NelmioSecurityBundle mints one nonce per response (ContentSecurityPolicyListener::doGetNonce caches it) and stamps it into whichever directive was asked, so two adjacent calls hand back the same string and put it in both #}
                {# Nonceing style-src on every page and not only on the ones rendering an inline <style> (the Banner component, say) is deliberate: a nonce present on a directive disables 'unsafe-inline' for it, so a rule varying page by page would break inline styles on those pages alone #}
                {% set cspNonce = csp_nonce('script') %}
                {% set cspNonce = csp_nonce('style') %}
                <meta name="csp-nonce" content="{{ cspNonce }}">

                {# "noindex, follow" when a template marked itself as non-indexable (a Page does, see @c975LSite/pages/page.html.twig), and on every error page: "status_code" is only ever set by Symfony's error renderer, and a 404/410/500 rendered with this layout would otherwise inherit the "index, follow" default and invite search engines to index it. "follow" is kept in both cases so the links the page carries still pass on #}
                <meta name="robots" content="{{ robots|default(status_code is defined and status_code >= 400 ? 'noindex, follow' : 'index, follow') }}">

                <title>{% block title %}{{ pageTitle }}{% endblock %}</title>
                <meta property="og:title" content="{{ pageTitle }}">
                <meta property="og:type" content="website">
                {% if siteName %}
                    <meta property="og:site_name" content="{{ siteName }}">
                {% endif %}
                {% if config('site-author') %}
                    <meta name="author" content="{{ config('site-author') }}">
                {% endif %}
                <meta name="copyright" content="{{ site_copyright() }}">
{# The page's own summary, stated by the template rendering it under this name and no other - a Page from its column, a book, a product or a photo from their entity #}
{# Reduced to plain text: the summary comes from a rich-text column often enough that a template feeding one raw would publish escaped markup as its description, and the filter leaves a summary already plain untouched #}
                {% if summarySocialNetwork is defined and summarySocialNetwork is not empty %}
                    <meta name="description" content="{{ summarySocialNetwork|plain_text }}">
                    <meta property="og:description" content="{{ summarySocialNetwork|plain_text|slice(0, 150) }}">
                {% endif %}
                {% if ogImage is defined %}
                    <meta property="og:image" content="{{ ogImage }}">
{# Stated only where they are known - the media library holds them as columns: a network reading them keeps the thumbnail's room before it is loaded, and guessing them would be worse than saying nothing. The intrinsic pair and not the raw columns, which an admin may have typed as a css length ("50%", "auto"), where Open Graph only reads a bare pixel count #}
                    {% if ogImageMedia is not null and ogImageMedia.intrinsicWidth and ogImageMedia.intrinsicHeight %}
                        <meta property="og:image:width" content="{{ ogImageMedia.intrinsicWidth }}">
                        <meta property="og:image:height" content="{{ ogImageMedia.intrinsicHeight }}">
                    {% endif %}
{# What the image shows, for whoever is read the share rather than shown it. The template that set the image itself is the only one that knows, hence the "ogImageAlt" it may set next to it - otherwise it is the media's own alternative text #}
                    {% set ogImageAltText = ogImageAlt is defined and ogImageAlt is not empty ? ogImageAlt : (ogImageMedia is not null ? ogImageMedia.alt : null) %}
                    {% if ogImageAltText %}
                        <meta property="og:image:alt" content="{{ ogImageAltText }}">
                    {% endif %}
                {% endif %}

                {% set canonicalUrl = canonical_url() %}
                {% if canonicalUrl %}
                    <meta property="og:url" content="{{ canonicalUrl }}">
                    <link rel="canonical" href="{{ canonicalUrl }}">
                {% endif %}

{# The same page written in other languages, when the template rendering it says so: a language code for key, the absolute url of that version for value. A group is read as a whole and every page of it names all of them, itself included - a template handing over its siblings alone would declare a group no search engine keeps #}
                {% if alternates is defined and alternates is not empty %}
                    {% for hreflang, alternateUrl in alternates %}
                        <link rel="alternate" hreflang="{{ hreflang }}" href="{{ alternateUrl }}">
                    {% endfor %}
                {% endif %}

                {% if favicon is defined %}
                    <link rel="icon" type="image/x-icon" href="{{ favicon }}">
                {% endif %}
                {% if appleTouchIcon is defined %}
                    <link rel="apple-touch-icon" href="{{ appleTouchIcon }}">
                    <link rel="apple-touch-icon-precomposed" href="{{ appleTouchIcon }}">
                {% endif %}
            {% endblock %}

            {# Matomo's origin, since this shell renders its snippet below: its script is fetched from a third-party host, so the DNS lookup and the TLS handshake would otherwise only start once that JS runs. Origin only, a preconnect must carry no path - and none at all when the instance is served by this very host, where the connection is already open. Gated on "site-enable-matomo" as the component itself is: a site whose tracking is off while its instance url stays filled would otherwise open a connection to a third party it never sends a measure to, which is exactly what turning the tracking off is meant to avoid #}
            {% block preconnect %}
                {% set matomoOrigin = config('site-enable-matomo') and config('site-matomo-url') ? config('site-matomo-url')|split('/')|slice(0, 3)|join('/') : '' %}
                {% set preconnectUrls = config('site-preconnect')|default([]) %}
                {% if matomoOrigin and matomoOrigin != app.request.getSchemeAndHttpHost() and matomoOrigin not in preconnectUrls %}
                    {% set preconnectUrls = preconnectUrls|merge([matomoOrigin]) %}
                {% endif %}
                {% for preconnectUrl in preconnectUrls %}
                    <link rel="preconnect" href="{{ preconnectUrl }}">
                {% endfor %}
            {% endblock %}

            {# Before the stylesheets, the @font-face rules sitting inside them; crossorigin is required even same-origin #}
            {% block fontPreload %}
                {% for font in font_preloads() %}
                    <link rel="preload" href="{{ asset('/' ~ font.path) }}" as="font" type="{{ font.type }}" crossorigin>
                {% endfor %}
            {% endblock %}

            {# data-turbo-track="reload": Turbo Drive doesn't re-evaluate the <head> between navigations, so after a deployment a visitor already on the site would get the new HTML with the old assets. Marked this way, the tags are compared by Turbo on every navigation (by their outerHTML) and a changed href - the ?v=<mtime> changes on every cache:warmup - triggers a full reload #}
            {% block stylesheets %}
                {% for stylesheet in bundle_stylesheets() %}
                    <link rel="stylesheet" href="{{ stylesheet }}" data-turbo-track="reload">
                {% endfor %}
            {% endblock %}

            {% block javascripts %}
                {% block importmap %}
{# data-turbo-track="reload" only applies to the <script> tags rendered here, not to the <link rel="modulepreload">, which is enough: the inline JSON of the <script type="importmap"> lists every digested JS URL and therefore stands as a complete fingerprint. The nonce, different on every request, causes no false positive: Turbo empties it before comparing the signatures #}
{# Symfony also puts this attribute on the <script> the es-module-shims polyfill loader injects into the <head>, which would fail the signature comparison on every navigation. Accepted: the polyfill only fires when HTMLScriptElement.supports('importmap') is false, so on a browser older than 2023 #}
                    {{ importmap(['app']|merge(bundle_scripts()), {'nonce': csp_nonce('script'), 'data-turbo-track': 'reload'}) }}
                {% endblock %}
            {% endblock %}
        {% endblock %}
    </head>

{# "id=top" and the "span id=bottom" closing the body are what the scroll buttons below point at #}
{# "bodyClasses" is what a child layout adds site-wide and "bodyClass" what a single page adds, where a class on the content would only cover the content: a screen laid on its own background (a photo gallery, a reader) paints the whole page with it, navbar and footer included #}
{# "password" is declared here rather than on each form: the controller reads every input[type=password] of its own element, so the body scope is what makes one declaration cover a page carrying several forms. "bodyControllers" is what a child layout adds next to it #}
    <body id="top" class="{{ bodyClasses|default('') }}{% block bodyClass %}{% endblock %}" data-controller="password{% if bodyControllers is defined and bodyControllers %} {{ bodyControllers }}{% endif %}">
        {% block body %}
{# The two buttons a long page is walked with, ordinary anchors working without javascript #}
            <twig:c975LUi:Scroll:Buttons />

            {# Empty here: a layout with a navbar fills it (see @c975LSite/layout.html.twig) #}
            {% block header %}{% endblock %}

            {% block main %}
                <main>
{# The page's own title as its heading, printed unless the template rendering it says otherwise - a Page carries that switch in a column, a template suppressing it overrides this block #}
                    {% block heading %}
                        {% if title is defined and title != '' and (headingDisplayed is not defined or headingDisplayed) %}
                            <h1>
                                {{ title }}
                            </h1>
                        {% endif %}
                    {% endblock %}

                    {# Before the flashes and outside their block: what debug mode held back is shown whichever page follows the send, a theme overriding the block below taking nothing of this over #}
                    <twig:c975LUi:Email:DebugPreview />

                    {% block flashes %}
                        {# Only a visitor who can hold a flash reads the bag: reading app.flashes starts the session, and it carries no such guard of its own. A theme overriding this block takes that reading over, hence the guard inside it #}
                        {% if ui_can_hold_flash() %}
                            {% for label, messages in app.flashes %}
{# Only the four tinted variants carry a background: any other label would print black ink on the dark page's own background, so an alias is mapped onto its tint and anything else falls back on "info" #}
                                {% set variant = { 'error': 'danger', 'notice': 'info' }[label]|default(label) %}
                                {% set variant = variant in ['success', 'info', 'warning', 'danger'] ? variant : 'info' %}
                                {% for message in messages %}
                                    <div class="flash alert alert-{{ variant }} text-center" role="alert">
                                        {{ message|raw|nl2br }}
                                    </div>
                                {% endfor %}
                            {% endfor %}
                        {% endif %}
                    {% endblock %}

                    {# No wrapper here: a layout centering its content on a grid adds it around this block #}
                    {% block container %}
                        {% block content %}{% endblock %}
                    {% endblock %}

                    {% block share %}
                        {% block navigationBottom %}{% endblock %}
                    {% endblock %}
                </main>
            {% endblock %}

            {# Outside main so the flex column leaves it against the footer. SocialBundle owns the band's markup and its config guard: including its fragment keeps that bundle optional, where calling share_buttons_default() here would fail at compile time on a site not installing it #}
            {{ include('@c975LSocial/shareButtons/default.html.twig', ignore_missing: true) }}

            {# Empty here: a layout with footer menus fills it (see @c975LSite/layout.html.twig) #}
            {% block footer %}{% endblock %}

            {# Both carry their own "is it enabled" guard, so nothing to check here. Rendered by the layout and not by a footer component, so a site overriding its footer keeps its tracking and its cookie banner #}
            <twig:c975LUi:Analytics:Matomo />
            <twig:c975LUi:Cookie:Consent />
        {% endblock %}
        <span id="bottom"></span>
    </body>
</html>
