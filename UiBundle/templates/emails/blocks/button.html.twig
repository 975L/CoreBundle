{# "Bulletproof" table button: only the structure is inline, so the colors, radius and font the layout's inliner copies from the theme's .btn/.btn-primary still apply - an inline value would win over them and freeze every site on one blue #}
<tr>
    <td style="padding:0 24px 24px;text-align:center;">
        <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="border-spacing:0;margin:0 auto;">
            <tr>
                <td class="btn-primary">
                    <a href="{{ url }}" target="_blank" class="btn" style="display:inline-block;margin:0;padding:12px 28px;font-size:15px;font-weight:bold;text-decoration:none;box-shadow:none;">{{ label }}</a>
                </td>
            </tr>
        </table>
    </td>
</tr>
