{# A plain-text system email's HTML twin (see EmailService), its lines kept, wrapped in the site's layout #}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tbody>
        <tr>
            <td class="text-left" style="font-size:14px;line-height:1.5;">{{ text|e|nl2br }}</td>
        </tr>
    </tbody>
</table>
