{# The questions a page is asked, each unfolding under its own summary - "details"/"summary" rather than a script, so the accordion works before any JavaScript loads and a printed page shows every answer #}
{% set items = items|default([])|filter(item => item.question|default('')) %}
{% if items is not empty %}
    {% set columns = columns|default(1) %}
    {# A page section like every other kind: the page's rhythm and measure through "block-section"/"section-wrap", its title through the shared head #}
    <section class="block-section faq faq--cols{{ columns }}"{% if anchor_id|default('') %} id="{{ anchor_id }}"{% endif %}>
        <div class="section-wrap">
            {{ include('@c975LUi/components/Section/_head.html.twig', {title: title|default(''), eyebrow: ''}) }}
            {# One name shared by the questions of this block, as the product items do: the browser folds the open answer when another unfolds, without a script - and scoped by the anchor, so two blocks on a page leave each other alone #}
            {% set group = 'faq-' ~ (anchor_id|default('') ?: 'items') %}
            <div class="faq__items">
                {% for item in items %}
                    <details class="faq__item" name="{{ group }}"{% if loop.first and openFirst|default(false) %} open{% endif %}>
                        <summary class="faq__question">{{ item.question }}</summary>
                        <div class="faq__answer">{{ item.answer|default('')|raw }}</div>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>

    {# Published only when the questions are laid in one column: Google reads a FAQPage as a single ordered list, and a two-column layout says the page is not one #}
    {% if 1 == columns %}
        {# Appended one by one rather than mapped: the list was filtered above, and json_encode writes gapped keys as an object where schema.org asks for an array #}
        {% set questions = [] %}
        {% for item in items %}
            {% set questions = questions|merge([{
                '@type': 'Question',
                'name': item.question,
                'acceptedAnswer': {'@type': 'Answer', 'text': item.answer|default('')|striptags},
            }]) %}
        {% endfor %}
        {% set faqJsonLd = {'@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': questions} %}
        <script type="application/ld+json">{{ faqJsonLd|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
    {% endif %}
{% endif %}
