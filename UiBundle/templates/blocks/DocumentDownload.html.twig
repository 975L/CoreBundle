{# One download card per attached PDF; document_thumbnail_url() checks the .webp exists on disk rather than guessing it, and names MediaController's route for a document reserved to members - the route, not this cached block, telling a member (the thumbnail) from anybody else (a lock) #}
{% set medias = block.media %}
{% set isMulti = medias|length > 1 %}
{# The row exists even for a single document: it is what keeps a card at its own width instead of the full measure #}
<div class="document-downloads">
    {% for media in medias %}
        {% set thumbnailUrl = document_thumbnail_url(media) %}
        {# No "download" attribute: it would deny the browser's own native PDF preview. media_url() rather than vich_uploader_asset(): a document reserved to members is served by its own route, public/ no longer holding it #}
        <a class="document-download" href="{{ media_url(media) }}" target="_blank" rel="noopener">
            {% if thumbnailUrl %}
                {# Decorative, the link's label already naming the document; aria-hidden doubles the empty alt so checkers don't read it as missing #}
                <img class="document-download__thumb" src="{{ thumbnailUrl }}" alt="" aria-hidden="true" loading="lazy">
            {% else %}
                <span class="document-download__thumb document-download__thumb--empty"></span>
            {% endif %}
            <span class="document-download__label">{{ isMulti ? (media.name|default(label)) : label }}</span>
            {# Not translated: a file-type badge, not a sentence #}
            <span class="badge document-download__ext">{{ buttonLabel|default('.PDF') }}</span>
        </a>
    {% endfor %}
</div>
