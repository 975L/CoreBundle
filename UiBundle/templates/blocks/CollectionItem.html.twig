{# Adapter for "collection" items only, never picklable nor persisted; "detailUrl"/"variant" are added by CollectionExtension::renderItems() #}
{% if variant is defined and variant == 'portfolio' %}
    {# Reuses portfolio-grid's classes so a Collection can look like a PortfolioGrid with no override #}
    {% set href = detailUrl|default(null) ?: url|default(null) %}
    {# Nothing to link to: a href="#" would be a dead link that still looks clickable #}
    {% set tag = href ? 'a' : 'div' %}
    {# Only a link leaving the site opens a tab of its own: an item's "url" is just as legitimately a page of this very site (a real Page written for that one project, which wins over the shared detail page - see SiteBundle's PageController::display()), and sending the visitor out of their tab for it would be wrong #}
    <{{ tag }} class="portfolio-grid__project"{% if href %} href="{{ href }}"{% if href starts with 'http' %} target="_blank" rel="noopener"{% endif %}{% endif %}>
        {% if imageUrl %}
            {# "imageUrl" alone is a bare string, so the dimensions come from the attached media instead #}
            {% set itemMedia = block.media|length > 0 ? block.media|first : null %}
            <div class="portfolio-grid__project-img">
                <img src="{{ imageUrl }}" alt="{{ title }}"{% if itemMedia and itemMedia.intrinsicWidth %} width="{{ itemMedia.intrinsicWidth }}"{% endif %}{% if itemMedia and itemMedia.intrinsicHeight %} height="{{ itemMedia.intrinsicHeight }}"{% endif %} loading="lazy">
            </div>
        {% endif %}
        <div class="portfolio-grid__project-body">
            {# The level the "collection" block resolved for its items, this markup's own <h3> when it drew none - see blocks/Collection.html.twig #}
            {# Matched against the offered levels and never interpolated, the same rule as every other stored value that writes a tag name: what the form holds is data, and data must not be able to write markup #}
            {% set titleLevel = level|default('') in ['h2', 'h3', 'h4'] ? level : 'h3' %}
            <{{ titleLevel }} class="portfolio-grid__project-title">{{ title }}</{{ titleLevel }}>
            {% if content %}<p class="portfolio-grid__project-text">{{ content }}</p>{% endif %}
        </div>
    </{{ tag }}>
{% else %}
    {% set resolvedImageUrl = imageUrl|default(null) %}
    {# Read under its own name because the two nesting branches below happen inside the component's context, where the card's own "content" prop - empty, nothing being passed to it - takes the place of the item's description #}
    {% set itemContent = content|default('') %}
    {# A source may hand back anything its own item has to say (see CollectionItem::$data); these four are the ones the Card already knows how to draw, and they open its "stat" variant - a portrait, a qualifying line, a score and a row of key figures, exactly the card an app renders itself when it holds the entity rather than a collection item #}
    {% set cardClass = class|default('') %}
    {% set cardClass = cardClass is iterable ? cardClass|join(' ') : cardClass %}
    {# The "compact" variant is the same card at a thumbnail's width, so it adds a class rather than a branch of markup of its own (see sass/_cards.scss) #}
    {% set cardClass = variant|default('') == 'compact' ? (cardClass ~ ' card--compact')|trim : cardClass %}
    {% if eyebrow|default('') or rating|default('') != '' or stats|default([])|length %}
        <twig:c975LUi:Card:Card
            tag="article"
            id="{{ id|default('') }}"
            title="{{ title }}"
            titleUrl="{{ detailUrl|default('') ?: url|default('') }}"
            level="{{ level|default('') }}"
            src="{{ resolvedImageUrl }}"
            alt="{{ title }}"
            eyebrow="{{ eyebrow|default('') }}"
            rating="{{ rating|default('') }}"
            stats="{{ stats|default([]) }}"
            class="{{ cardClass }}"
        >
            {# No wrapper of its own here, unlike the teaser below: the stat card already carries its own alignment (see "class"), and what a source nests under its figures - a link, a line of navigation - is markup it wrote itself, which has to come out as the app's own components render it #}
            {% if itemContent %}{{ itemContent|raw|nl2br }}{% endif %}
        </twig:c975LUi:Card:Card>
    {% elseif resolvedImageUrl or url %}
        <twig:c975LUi:Card:Card tag="article" id="{{ id|default('') }}" title="{{ title }}" titleUrl="{{ detailUrl|default('') }}" level="{{ level|default('') }}" class="{{ cardClass }}">
            {% if resolvedImageUrl %}
                {# Pixel size so the card reserves its image's box; nothing when the image is a bare string #}
                {% set cardMedia = block.media|length > 0 ? block.media|first : null %}
                <twig:c975LUi:Image:Link src="{{ resolvedImageUrl }}" class="{{ cardMedia ? cardMedia.cssClasses|join(' ') : '' }}" url="{{ url }}" target="{{ target|default('') }}" alt="{{ title }}" width="{{ cardMedia ? cardMedia.intrinsicWidth : '' }}" height="{{ cardMedia ? cardMedia.intrinsicHeight : '' }}"/>
            {% endif %}
            <div class="card-data">
                {# A <div>, not a <p>: raw Trix HTML is already block-level and a <p> would be split #}
                {% if itemContent %}<div class="text-center">{{ itemContent|raw|nl2br }}</div>{% endif %}
                {% if url %}<twig:c975LUi:Button:Button label="{{ buttonLabel|default(url) }}" url="{{ url }}" target="{{ target|default('') }}" icon="{{ buttonIcon|default('') }}"/>{% endif %}
            </div>
        </twig:c975LUi:Card:Card>
    {% else %}
        <twig:c975LUi:Card:Card tag="article" id="{{ id|default('') }}" title="{{ title }}" titleUrl="{{ detailUrl|default('') }}" level="{{ level|default('') }}" content="{{ content }}" class="{{ cardClass }}"/>
    {% endif %}
{% endif %}
