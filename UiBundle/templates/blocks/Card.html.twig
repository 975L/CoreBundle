{# Adapter mapping Block data to the Card component; "imageUrl" is a no-op fallback for CollectionItem #}
{% set cardMedia = block.media|length > 0 ? block.media|first : null %}
{% set resolvedImageUrl = cardMedia ? vich_uploader_asset(cardMedia) : imageUrl|default(null) %}
{# Matched against the twelve hues, not interpolated: the value comes from stored block data and must not write any class name (same rule as "background" in the section components). See BlockAccentChoiceType #}
{% set accentClass = accent|default('') in ['red', 'orange', 'yellow', 'lime', 'green', 'teal', 'cyan', 'blue', 'indigo', 'violet', 'pink', 'grey'] ? 'card--accent-' ~ accent : '' %}
{# Matched against the closed steps for the same reason, and shared with the flip card rather than prefixed "card-": both kinds read the very same token off these classes (see sass/_block-surface.scss). Unset writes none at all, and the card keeps whatever this site's theme gives it. See BlockRadiusChoiceType / BlockShadowChoiceType #}
{% set radiusClass = radius|default('') in ['none', 'small', 'medium', 'large'] ? 'block-radius-' ~ radius : '' %}
{% set shadowClass = shadow|default('') in ['none', 'small', 'medium', 'large'] ? 'block-shadow-' ~ shadow : '' %}
{% set classes = [class|default([])|join(' '), accentClass, radiusClass, shadowClass]|filter(name => name)|join(' ') %}
{# Read under its own name because the nesting below happens inside the component's context, where the card's own "content" prop - empty, nothing being passed to it - takes the place of this block's data #}
{% set blockContent = content|default('') %}
{% if resolvedImageUrl or url %}
    <twig:c975LUi:Card:Card id="{{ id|default('') }}" title="{{ title }}" level="{{ level|default('') }}" class="{{ classes }}">
        {% if resolvedImageUrl %}
            {# Pixel size reserves the image's box; nothing to pass when the image is a bare "imageUrl" string #}
            <twig:c975LUi:Image:Link src="{{ resolvedImageUrl }}" class="{{ cardMedia ? cardMedia.cssClasses|join(' ') : '' }}" url="{{ url }}" target="{{ target|default('') }}" alt="{{ title }}" width="{{ cardMedia ? cardMedia.intrinsicWidth : '' }}" height="{{ cardMedia ? cardMedia.intrinsicHeight : '' }}"/>
        {% endif %}
        <div class="card-data">
            {# A <div>, not a <p>: raw Trix HTML is already block-level and a <p> would be split #}
            {% if blockContent %}<div class="text-center">{{ blockContent|raw|nl2br }}</div>{% endif %}
            {% if url %}<twig:c975LUi:Button:Button label="{{ buttonLabel|default(url) }}" url="{{ url }}" target="{{ target|default('') }}" icon="{{ buttonIcon|default('') }}"/>{% endif %}
        </div>
    </twig:c975LUi:Card:Card>
{% else %}
    <twig:c975LUi:Card:Card id="{{ id|default('') }}" title="{{ title }}" level="{{ level|default('') }}" content="{{ content }}" class="{{ classes }}"/>
{% endif %}
