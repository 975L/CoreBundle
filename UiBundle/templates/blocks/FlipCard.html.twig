{# Adapter mapping Block data to the FlipCard component; medias are ordered, first = front face, second = back face #}
{# Matched against the twelve hues, not interpolated: the value comes from stored block data and must not write any class name (same rule as "background" in the section components). See BlockAccentChoiceType #}
{# "card--accent-*" and not a flip-card-specific class on purpose: those twelve classes only point --card-accent at a token and paint nothing themselves (see sass/_cards.scss), and a custom property set here is inherited by the two ".card" faces inside #}
{% set accentClass = accent|default('') in ['red', 'orange', 'yellow', 'lime', 'green', 'teal', 'cyan', 'blue', 'indigo', 'violet', 'pink', 'grey'] ? 'card--accent-' ~ accent : '' %}
{% set classes = (class|default([])|join(' ') ~ ' ' ~ accentClass)|trim %}
<twig:c975LUi:FlipCard:FlipCard id="{{ id|default('') }}" title="{{ title|default('') }}" level="{{ level|default('') }}" content="{{ content|default('') }}" backTitle="{{ backTitle|default('') }}" backContent="{{ backContent|default('') }}" media="{{ block.media }}" ratio="{{ ratio|default('free') }}" class="{{ classes }}"/>
