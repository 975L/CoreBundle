{# The cookies policy's section on an audience measurement provider shipping none of its own (providers/analytics-<slug>.en.html.twig, which a site can add under templates/bundles/c975LUiBundle/) #}
<section data-legal-id="audience-measurement">
	<h2>Audience measurement ({{ analyticsProvider.name }})</h2>
	<div class="text text-justify">
		This site measures its traffic with {{ analyticsProvider.name }}, for internal statistics only, never for advertising or resale to third parties. This service processes the data under its own privacy policy.
	</div>
</section>
