{% if private %}
# This site asked to stay out of search engines ("seo-robots-private"), so nothing else
# is declared below: paths, AI crawlers and the sitemap all describe a site meant to be
# indexed. Advisory like the rest of this file - what must not be reached has to sit
# behind authentication, never behind this line.
User-agent: *
Disallow: /
{% else %}
User-agent: *
Allow: /
{% for path in disallow %}
Disallow: {{ path }}
{% endfor %}
{% if extra %}
{{ extra }}
{% endif %}
{% if blockAi and aiCrawlers %}

# AI crawlers that harvest pages to train models. Advisory only: this is honoured
# by the operators listed here, nothing enforces it.
{% for crawler in aiCrawlers %}
User-agent: {{ crawler }}
{% endfor %}
Disallow: /
{% if answerEngines %}

# Left allowed on purpose: these fetch a page to answer someone's question and cite
# it back, so blocking them would only cost visibility, and they are what reads the
# llms.txt this site publishes. They are named here rather than given a group of
# their own, which would take them out of the "User-agent: *" rules above:
{% for names in answerEngines|batch(4) %}
#   {{ names|join(', ') }}
{% endfor %}
{% endif %}
{% endif %}
{% endif %}
{% if sitemap %}

Sitemap: {{ sitemap }}
{% endif %}
