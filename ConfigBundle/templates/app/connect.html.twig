{# Rendered by AppConnectController - the app's own scaffolded layout first, then SiteBundle's, then UiBundle's minimal one, as the account pages do #}
{% extends ['layout.html.twig', '@c975LSite/layout.html.twig', '@c975LUi/layout.html.twig'] %}
{% trans_default_domain 'config' %}

{% set title = 'label.app_connect'|trans %}

{# A page of one account alone, as the login page: nothing to offer a search result #}
{% set robots = 'noindex, follow' %}

{# Loaded whole even when Turbo brings the visitor here from the login form: a page Turbo swaps in keeps the policy of the one before, whose "form-action" lacks the app's scheme (see AppConnectCspSubscriber), and the button then does nothing #}
{% block meta %}
    {{ parent() }}
    <meta name="turbo-visit-control" content="reload">
{% endblock %}

{% block content %}
    <div class="alert alert-info text">
        <p>{{ 'text.app_connect_intro'|trans({'%identifier%': app.user.userIdentifier}) }}</p>
        <p>{{ 'text.app_connect_password'|trans }}</p>
    </div>

    {# Posted to the very address the app opened, which carries what it asked for. Left to the browser rather than Turbo: its fetch() would follow the redirection to the app under "connect-src", which no app scheme is in #}
    <form method="post" data-turbo="false">
        <input type="hidden" name="_token" value="{{ csrf_token('app_connect') }}">
        <button class="btn btn-large btn-primary" type="submit">
            {{ 'label.app_connect_button'|trans }}
        </button>
        <a class="btn btn-large" href="{{ cancelUrl }}">{{ 'label.app_connect_cancel'|trans }}</a>
    </form>
{% endblock %}
