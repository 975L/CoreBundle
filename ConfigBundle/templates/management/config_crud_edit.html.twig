{% extends '@EasyAdmin/crud/edit.html.twig' %}

{% block main %}
    {# The language the setting is being written in, drawn by the partial every c975L edit screen shares. The defaults are what the screen of a setting no language can change hands over: those variables are simply absent there (see ConfigCrudController::addContentLocaleParameters), and an include under strict_variables would raise rather than draw nothing #}
    {{ include('@c975LConfig/management/_content_locale_tabs.html.twig', {
        content_locales: config_content_locales|default([]),
        content_locale: config_content_locale|default(null),
        content_default_locale: config_default_locale|default(null),
        content_urls: config_content_urls|default({}),
    }) }}

    {% if config_content_locale|default(null) is not null %}
        <p class="text-muted">{{ 'description.config_translation'|trans({}, 'config') }}</p>
    {% else %}
        <p>{{ ('description.config'|trans({}, 'config')) }}</p>
    {% endif %}

    {{ parent() }}
{% endblock main %}
