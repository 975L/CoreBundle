{% extends '@EasyAdmin/page/content.html.twig' %}

{# Intermediate "pick a group" screen, each row linking into the same index filtered to it #}
{% block main %}
    <h1>{{ ('label.config'|trans({}, 'config')) }}</h1>

    <p>{{ ('description.config'|trans({}, 'config')) }}</p>

    {# The toggle EasyAdmin draws on its grid, which this screen has to draw itself since it replaces the index page and its global actions. Without it, a group holding only sensitive entries - the payment keys - was reachable only by showing them from another group's listing first #}
    {% if canShowSensitive|default(false) %}
        <p>
            <a class="btn btn-{{ showSensitive|default(false) ? '' : 'outline-' }}warning btn-sm" href="{{ sensitiveToggleUrl }}">
                <i class="fa fa-eye{{ showSensitive|default(false) ? '-slash' : '' }}"></i>
                {{ (showSensitive|default(false) ? 'label.hide_sensitive' : 'label.show_sensitive')|trans({}, 'config') }}
            </a>
        </p>
    {% endif %}

    {{ include('@c975LConfig/management/_alerts.html.twig', {
        alerts: alerts|default([]),
        title: alertsTitle|default(''),
    }) }}

    {% if bands|default({})|length > 0 or emptyCount|default(0) > 0 %}
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>{{ ('label.group'|trans({}, 'config')) }}</th>
                        <th>{{ ('label.group_items_count'|trans({}, 'config')) }}</th>
                    </tr>
                </thead>
                {# A state rather than a group, drawn first and apart: it cuts across every group and gathers the sensitive entries too, which the rows below hide unless the toggle is on #}
                {% if emptyCount|default(0) > 0 %}
                    <tbody>
                        <tr class="table-warning">
                            <td>
                                <a href="{{ ea_url().setAction('index').set('group', emptyGroup) }}">{{ ('label.group_empty'|trans({}, 'config')) }}</a>
                            </td>
                            <td>{{ emptyCount }}</td>
                        </tr>
                    </tbody>
                {% endif %}
                {# Three bands rather than one flat list: what the site says of itself, what its bundles brought, and what is touched once (see ConfigGroupLabelResolver::bands) #}
                {% for band, groups in bands|default({}) %}
                    <tbody>
                        <tr>
                            <th colspan="2" class="text-muted">{{ ('label.band_' ~ band)|trans({}, 'config') }}</th>
                        </tr>
                        {% for group, count in groups %}
                            <tr>
                                <td>
                                    <a href="{{ ea_url().setAction('index').set('group', group) }}" data-config-group-link>{{ ('label.group_' ~ group)|trans({}, 'config') }}</a>
                                </td>
                                <td>{{ count }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                {% endfor %}
            </table>
        </div>
    {% endif %}
{% endblock main %}
