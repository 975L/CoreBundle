{% extends '@EasyAdmin/page/content.html.twig' %}

{% block main %}
    <h1>{{ 'label.guided_projects'|trans({}, 'config') }}</h1>
    <p>{{ 'label.guided_projects_help'|trans({}, 'config') }}</p>
    <p class="text-muted small">{{ 'label.guided_projects_intro'|trans({}, 'config') }}</p>

    {# Merged across every bundle's GuidedProjectProvider, one section per bundle - replayable exercises, not a one-time wizard. Every button starts out saying "Start", assets/js/guided-project.js filling in resume and badge from the browser's own storage #}
    <div data-guided-project-list>
        {% for bundle, projects in groups %}
            <h2 class="mt-4">{{ bundle is empty ? siteName : bundle }}</h2>
            <ul class="list-unstyled">
                {% for project in projects %}
                    <li class="mb-2">
                        <button type="button" class="btn btn-sm btn-secondary" data-guided-project-slug="{{ project.slug }}">{{ 'label.guided_project_start'|trans({}, 'config') }}</button>
                        <strong>{{ project.label }}</strong>
                        <span class="badge text-bg-success" data-guided-project-badge="{{ project.slug }}" hidden>{{ 'label.guided_project_done'|trans({}, 'config') }}</span>
                        {%- if project.description %} — <span class="text-muted small">{{ project.description }}</span>{% endif %}
                        <a href="{{ project.film }}" target="_blank" rel="noopener" class="small ms-1">{{ 'label.guided_project_film'|trans({}, 'config') }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endfor %}
    </div>
{% endblock main %}
