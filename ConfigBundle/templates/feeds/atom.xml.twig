<?xml version="1.0" encoding="utf-8"?>
{# Escaped as html by Twig, which is what Atom expects of text nodes and of a content of type "html" #}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ language }}">
    <title>{{ title }}</title>
    <id>{{ selfUrl }}</id>
    <link rel="self" type="application/atom+xml" href="{{ selfUrl }}"/>
    <link rel="alternate" type="text/html" href="{{ siteUrl }}"/>
    <updated>{{ updated|date(constant('DATE_ATOM')) }}</updated>
    <author>
        <name>{{ author }}</name>
    </author>
{% for entry in entries %}
    <entry>
        <title>{{ entry.title }}</title>
        <id>{{ entry.url }}</id>
        <link rel="alternate" type="text/html" href="{{ entry.url }}"/>
        <updated>{{ entry.updated|date(constant('DATE_ATOM')) }}</updated>
{% if entry.summary %}
        <summary>{{ entry.summary }}</summary>
{% endif %}
{# The image goes in the content, which is what a feed reader displays #}
{% if entry.image|default(null) %}
        <content type="html">{{ '<p><img src="' ~ entry.image|e ~ '" alt=""></p>' ~ (entry.summary ? '<p>' ~ entry.summary|e ~ '</p>' : '') }}</content>
{% endif %}
    </entry>
{% endfor %}
</feed>
