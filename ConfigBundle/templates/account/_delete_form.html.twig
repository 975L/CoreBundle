{# What deleting the account does, then the address typed again - drawn by the deletion page and by the dialog of the member's page alike, the form posting to AccountDeleteController either way #}
{% trans_default_domain 'config' %}
{{ include('@c975LConfig/account/_delete_effects.html.twig') }}

{{ form_start(form, {action: path('config_account_delete')}) }}
    <p class="text">{{ 'text.account_delete_confirm'|trans({'%email%': app.user.email}) }}</p>
    {{ form_row(form.email) }}

    <button class="btn btn-large btn-danger" type="submit">
        {{ 'label.account_delete_button'|trans }}
    </button>
{{ form_end(form) }}
