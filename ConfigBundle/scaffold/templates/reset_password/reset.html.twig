{% extends 'layout.html.twig' %}

{% set title = 'label.reset_password'|trans({}, 'config') %}

{# The url carries a single-use token, so there is nothing here for a search engine to keep #}
{% set robots = 'noindex, follow' %}

{% block content %}
    <h1>{{ 'label.reset_password'|trans({}, 'config') }}</h1>

    {{ form_start(resetForm) }}
        {{ form_row(resetForm.plainPassword) }}
        <button class="btn btn-large btn-primary" type="submit">{{ 'label.reset_password'|trans({}, 'config') }}</button>
    {{ form_end(resetForm) }}
{% endblock %}