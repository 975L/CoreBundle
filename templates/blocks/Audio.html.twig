{# Adapter for the dynamic Block system — resolves the uploaded media, file and format alike, into the Audio component #}
{% set audio = block.media|first %}
{% if audio %}
    <twig:c975LUi:Audio:Audio src="{{ vich_uploader_asset(audio) }}" type="{{ audio.mimeType }}" title="{{ title|default('') }}" description="{{ description|default('') }}" class="{{ class|default([]) }}"/>
{% endif %}
