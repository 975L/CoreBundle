{# Adapter mapping Block data to the Card component; "imageUrl" is a no-op fallback for CollectionItem #}
{% set cardMedia = block.media|length > 0 ? block.media|first : null %}
{% set resolvedImageUrl = cardMedia ? vich_uploader_asset(cardMedia) : imageUrl|default(null) %}
{% if resolvedImageUrl or url %}
    <twig:c975LUi:Card:Card id="{{ id|default('') }}" title="{{ title }}" level="{{ level|default('') }}" class="{{ class|default([])|join(' ') }}">
        {% if resolvedImageUrl %}
            {# Pixel size reserves the image's box; nothing to pass when the image is a bare "imageUrl" string #}
            <twig:c975LUi:Image:Link src="{{ resolvedImageUrl }}" class="{{ cardMedia ? cardMedia.cssClasses|join(' ') : '' }}" url="{{ url }}" target="{{ target|default('') }}" alt="{{ title }}" width="{{ cardMedia ? cardMedia.intrinsicWidth : '' }}" height="{{ cardMedia ? cardMedia.intrinsicHeight : '' }}"/>
        {% endif %}
        <div class="card-data">
            {# A <div>, not a <p>: raw Trix HTML is already block-level and a <p> would be split #}
            {% if content %}<div class="text-center">{{ content|raw|nl2br }}</div>{% endif %}
            {% if url %}<twig:c975LUi:Button:Button label="{{ buttonLabel|default(url) }}" url="{{ url }}" target="{{ target|default('') }}" icon="{{ buttonIcon|default('') }}"/>{% endif %}
        </div>
    </twig:c975LUi:Card:Card>
{% else %}
    <twig:c975LUi:Card:Card id="{{ id|default('') }}" title="{{ title }}" level="{{ level|default('') }}" content="{{ content }}" class="{{ class|default([])|join(' ') }}"/>
{% endif %}
