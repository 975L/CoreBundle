{# Widget for c975L\UiBundle\Form\CaptchaType - registered app-wide via c975LUiBundle::prependExtension() #}
{% block c975l_ui_captcha_widget %}
{# Overriding at the "c975l_ui_captcha" prefix bypasses "hidden_widget", the block that would otherwise
   have set this - without it form_widget_simple falls back to its own "text" default and the token field
   renders as a visible input #}
    {%- set type = type|default('hidden') -%}
{# Nothing but a plain hidden input when no keys are configured: no controller, no request to Google #}
    {% if enabled %}
{# No <script> tag here, inline or otherwise: the "captcha" Stimulus controller only fetches Google's
   api.js once the visitor actually interacts with the form. Loading it upfront cost ~765 KB and ~1.5 s
   of main thread on every page carrying a form, and dropped a third-party _GRECAPTCHA cookie on
   visitors who never submitted anything. As a bonus, there is no inline script left to nonce under a
   strict CSP (see assets/js/captcha.js) #}
        {% set attr = attr|merge({
            'data-controller': 'captcha',
            'data-captcha-site-key-value': site_key,
            'data-captcha-action-value': action_name,
        }) %}
    {% endif %}
    {{- block('form_widget_simple') -}}
{% endblock %}
