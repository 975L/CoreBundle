{# Static usage: <twig:c975LUi:Text:Readmore text="{{ text }}" id="{{ id }}"/> #}
<input type="checkbox" id="readmore-toggle-{{ id }}" class="readmore-toggle" hidden>
<div class="readmore-content">{{ text|raw|nl2br }}</div>
<label for="readmore-toggle-{{ id }}" class="readmore-toggle-label">
    <span class="read-more">{{ 'label.readmore'|trans({}, 'site') }}</span>
    <span class="read-less">{{ 'label.readless'|trans({}, 'site') }}</span>
</label>