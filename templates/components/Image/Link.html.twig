{# <twig:c975LUimage:Link [label=""] src="your-path/file.ext" url="yourdomain.ext" [class="your-css-classes"] [classLabel="your-css-classes-label"] [alt=""] [width="width"] [height="height"] [target=""] [above="true"] [priority=false]/> #}
{% set label = label | default("") %}
{% set above = above | default(false) | to_bool %}
{# "priority": set it on an above-the-fold image, so it is not lazy-loaded (see Image.html.twig) #}
{% set priority = priority | default(false) | to_bool %}
{# Same rule as Image.html.twig: "img-responsive" and explicit dimensions are combined, except for a height with no width, where "height: auto" would override it #}
{% set heightOnly = height is defined and height != "" and (width is not defined or width == "") %}
{% set imgResponsive = heightOnly ? "" : "img-responsive" %}
{# No "url": nothing to link to, so this must not render as an <a> at all - a href="" would be a dead link that still looks clickable #}
{% set tag = url ? 'a' : 'span' %}
{# The link's accessible name: an explicit "ariaLabel", else the visible "label" (stripped of the html
   it may carry), else the image's own "alt". The former hardcoded fallback had every image link on the
   site announce itself as "image", overriding the label rendered right next to it. Nothing to name it
   with: no attribute at all rather than a meaningless one, letting the img's alt name the link. Only
   ever set on the <a>, aria-label is ignored on a plain <span> #}
{% set ariaLabel = ariaLabel|default('') is not empty ? ariaLabel : (label != '' ? label|striptags : alt|default('')) %}
<p class="text-center">
    <{{ tag }}{% if url %} href="{{ url }}"{% if target is defined and target != "" %} target="{{ target }}"{% endif %}{% if ariaLabel != '' %} aria-label="{{ ariaLabel }}"{% endif %}{% endif %}>
        {% if above and label != '' %}
            <span class="img-above {{ classLabel|default("") }}">{{ label|raw }}</span>
            <br>
        {% endif %}
        <img src="{{ absolute_url(asset(src)) }}" class="img {{ imgResponsive }} {{ class|default("") }}" alt="{{ alt|default("") }}" {% if width is defined and width != "" %} width="{{ width }}" {% endif %} {% if height is defined and height != "" %} height="{{ height }}" {% endif %} {% if priority %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {% if not above and label != '' %}
            <br>
            <span class="img-below {{ classLabel|default("") }}">{{ label|raw }}</span>
        {% endif %}
    </{{ tag }}>
</p>